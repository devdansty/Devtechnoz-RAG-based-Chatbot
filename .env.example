PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-pinecone-index-name
PINECONE_NAMESPACE=devtechnoz
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
RAG_MAX_OUTPUT_TOKENS=1200

# Optional: enable persistent website chat transcripts with PostgreSQL.
# In Railway, reference the PostgreSQL service's DATABASE_URL variable.
# DATABASE_URL=postgresql://user:password@host:5432/database
# Protects the transcript admin page at /admin.
# CHAT_ADMIN_PASSWORD=replace-with-a-long-random-password
